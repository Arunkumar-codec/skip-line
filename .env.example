# SkipLine environment configuration (copy to .env and fill in real values)
# NEVER commit .env — it contains real credentials and is gitignored.

# ── Application ──────────────────────────────────────────────────────────────
# "development" (default) | "production"
# In production, DB_PASSWORD, SECRET_KEY, JWT_SECRET_KEY and ADMIN_PASSWORD
# are ALL required and must not be insecure placeholders — the app refuses
# to start without them.
APP_ENV=development

# APP_DEBUG: FastAPI debug pages + SQLAlchemy SQL echo. MUST be false in
# production (the app refuses to start with APP_DEBUG=true there).
APP_DEBUG=false

# ── Database (MySQL) ─────────────────────────────────────────────────────────
# DB_PASSWORD is REQUIRED: there is no default password in the code. The
# application fails to start in production without it.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=skipline
DB_USER=skipline_user
DB_PASSWORD=<set-a-strong-database-password>

# Docker (docker-compose.yml) — BOTH are required when running `make docker-up`
# (compose fails with a clear error when either is unset; no built-in fallback)
MYSQL_ROOT_PASSWORD=<set-a-strong-root-password>

# ── Security ─────────────────────────────────────────────────────────────────
# Required in production (minimum 32 characters). Used for session-cookie
# signing and identity-document encryption — set a STABLE value, not a
# per-restart random one.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<set-a-long-random-64+-char-secret>

# JWT signing secret. Required in production (minimum 32 characters).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=<set-a-long-random-64+-char-secret>

# ── Admin bootstrap (first Super Admin seeded at startup if none exist) ────
# Required in production (minimum 12 characters, not a common placeholder).
# If unset in development, the default admin is NOT seeded.
ADMIN_PASSWORD=<set-a-strong-password-12+-chars>

# ── Phase 8 hardening options ────────────────────────────────────────────────

# WebSocket scaling / distributed rate limiting (Phase 6/8). Empty = single
# worker, in-process delivery and per-worker rate limits. In compose, the
# app service defaults to redis://redis:6379/0.
# REDIS_URL=redis://redis:6379/0

# Distributed rate-limit tuning (Phase 8, SEC-004). Defaults: 20 auth-path
# requests / 60 s per IP, 300 requests / 60 s per authenticated principal
# (the global IP window is 200 / 60 s — a code constant).
# RATE_LIMIT_AUTH_REQUESTS=20
# RATE_LIMIT_ACCOUNT_REQUESTS=300

# Local ClamAV malware scanning (Phase 8, SEC-003). The compose file ships
# a clamav service; set this to true AND confirm the container is healthy
# before relying on scans for real uploads. While it is false, upload /
# attachment rows record scan_status="disabled" — they are NEVER "clean".
# CLAMAV_ENABLED=false
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310
# CLAMAV_SCAN_TIMEOUT_SECONDS=10

# CSRF double-submit enforcement (Phase 8, SEC-004). Automatic in
# production (app_env="production"); set true to force it in development.
# CSRF_ENFORCE=false

# Nginx config selection for compose: a FILE NAME inside ./nginx.
# Dev default: nginx.conf (HTTP on :80). For HTTPS use
# nginx.production.conf, obtain certs per docs/deployment.md and place
# them under ./nginx/ssl (gitignored — certs stay out of Git).
# NGINX_CONF=nginx.conf

# ── AI booking assistant (Phase 9, Workstreams C & D) ───────────────────────
# OpenAI-compatible chat endpoint. Leave AI_PROVIDER empty to disable the AI
# assistant entirely — every /ai endpoint then responds with a graceful
# "unavailable" message and the manual booking flow remains the path.
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=            # secret — keep out of logs and VCS, same as DB_PASSWORD
# AI_REQUEST_TIMEOUT_SECONDS=20
# AI_MAX_HISTORY_TURNS=12
# AI_MAX_TOOL_ROUNDS=6

