# SkipLine environment configuration (copy to .env and fill in real values)
# NEVER commit .env — it contains real credentials and is gitignored.

# ── Application ──────────────────────────────────────────────────────────────
# "development" (default) | "production"
# In production, DB_PASSWORD, SECRET_KEY, JWT_SECRET_KEY and ADMIN_PASSWORD
# are ALL required and must not be insecure placeholders — the app refuses
# to start without them.
APP_ENV=development

# ── Database (MySQL) ─────────────────────────────────────────────────────────
# DB_PASSWORD is REQUIRED: there is no default password in the code. The
# application fails to start in production without it.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=skipline
DB_USER=skipline_user
DB_PASSWORD=<set-a-strong-database-password>

# Docker (docker-compose.yml) — BOTH are required when running `make docker-up`
# (compose fails with a clear error when either is unset; no built-in fallback)
MYSQL_ROOT_PASSWORD=<set-a-strong-root-password>

# ── Security ─────────────────────────────────────────────────────────────────
# Required in production (minimum 32 characters). Used for session-cookie
# signing and identity-document encryption — set a STABLE value, not a
# per-restart random one.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<set-a-long-random-64+-char-secret>

# JWT signing secret. Required in production (minimum 32 characters).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=<set-a-long-random-64+-char-secret>

# ── Admin bootstrap (first Super Admin seeded at startup if none exist) ────
# Required in production (minimum 12 characters, not a common placeholder).
# If unset in development, the default admin is NOT seeded.
ADMIN_PASSWORD=<set-a-strong-password-12+-chars>
